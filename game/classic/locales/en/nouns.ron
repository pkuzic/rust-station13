// Nouns of the classic build, keyed by prototype id. English needs `nom` and `indef`
// (with its article), plus plural `nom` for countable nouns.
{
    "crowbar": (gender: neuter, sg: (nom: "crowbar", indef: "a crowbar"), pl: Some((nom: "crowbars"))),
    "wrench": (gender: neuter, sg: (nom: "wrench", indef: "a wrench"), pl: Some((nom: "wrenches"))),
    "airlock": (gender: neuter, sg: (nom: "airlock", indef: "an airlock"), pl: Some((nom: "airlocks"))),
    "metal-sheet": (gender: neuter, sg: (nom: "metal sheet", indef: "a metal sheet"), pl: Some((nom: "metal sheets"))),
    "oxygen-tank": (gender: neuter, sg: (nom: "oxygen tank", indef: "an oxygen tank"), pl: Some((nom: "oxygen tanks"))),
    "screwdriver": (gender: neuter, sg: (nom: "screwdriver", indef: "a screwdriver"), pl: Some((nom: "screwdrivers"))),
    "wirecutters": (gender: plural, sg: (nom: "wirecutters", indef: "a pair of wirecutters")),
    "apc": (gender: neuter, sg: (nom: "APC", indef: "an APC")),
    "id-card": (gender: neuter, sg: (nom: "ID card", indef: "an ID card"), pl: Some((nom: "ID cards"))),
    "human": (gender: neuter, sg: (nom: "human", indef: "a human"), pl: Some((nom: "humans"))),
    // Body parts, for messages like "attacked in the chest".
    "zone-head": (gender: neuter, sg: (nom: "head")),
    "zone-chest": (gender: neuter, sg: (nom: "chest")),
    "zone-groin": (gender: neuter, sg: (nom: "groin")),
    "zone-l_arm": (gender: neuter, sg: (nom: "left arm")),
    "zone-r_arm": (gender: neuter, sg: (nom: "right arm")),
    "zone-l_hand": (gender: neuter, sg: (nom: "left hand")),
    "zone-r_hand": (gender: neuter, sg: (nom: "right hand")),
    "zone-l_leg": (gender: neuter, sg: (nom: "left leg")),
    "zone-r_leg": (gender: neuter, sg: (nom: "right leg")),
    "zone-l_foot": (gender: neuter, sg: (nom: "left foot")),
    "zone-r_foot": (gender: neuter, sg: (nom: "right foot")),
    // Atmospherics machinery.
    "pipe": (gender: neuter, sg: (nom: "pipe", indef: "a pipe"), pl: Some((nom: "pipes"))),
    "air-tank": (gender: neuter, sg: (nom: "air tank", indef: "an air tank"), pl: Some((nom: "air tanks"))),
    "pump": (gender: neuter, sg: (nom: "gas pump", indef: "a gas pump"), pl: Some((nom: "gas pumps"))),
    "valve": (gender: neuter, sg: (nom: "manual valve", indef: "a manual valve"), pl: Some((nom: "manual valves"))),
    "vent": (gender: neuter, sg: (nom: "air vent", indef: "an air vent"), pl: Some((nom: "air vents"))),
    "scrubber": (gender: neuter, sg: (nom: "air scrubber", indef: "an air scrubber"), pl: Some((nom: "air scrubbers"))),
    "connector": (gender: neuter, sg: (nom: "connector port", indef: "a connector port"), pl: Some((nom: "connector ports"))),
    "canister": (gender: neuter, sg: (nom: "canister", indef: "a canister"), pl: Some((nom: "canisters"))),
    "smes": (gender: neuter, sg: (nom: "SMES", indef: "a SMES unit"), pl: Some((nom: "SMES units"))),
    "cable": (gender: neuter, sg: (nom: "power cable", indef: "a power cable"), pl: Some((nom: "power cables"))),
}
