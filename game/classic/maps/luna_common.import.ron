// Rules shared by every region imported from NSV Luna's map (rs13-dmm-import): what each
// Luna type becomes. Each region's rules file names this one as its `base` and adds where
// to cut, who starts there and its areas. Spec: docs/reference/map-import.md.
(
    source: "NSV Luna (github.com/SS13/luna, commit e13cf12) maps/NSV_Luna.dmm",
    z: 0,
    columns: (0, 0),
    rows: (0, 0),

    turfs: [
        (path: "/turf/space", tile: (id: "space")),
        (path: "/turf/simulated/floor", tile: (id: "floor")),
        (path: "/turf/simulated/floor/plating", tile: (id: "plating")),
        // The engine core's floor. It should start in vacuum; zones all start with air.
        (path: "/turf/simulated/floor/engine", tile: (id: "plating")),
        (path: "/turf/simulated/wall", tile: (id: "wall", solid: true)),
        (path: "/turf/simulated/wall/r_wall", tile: (id: "r-wall", solid: true)),
        (path: "/turf/simulated/wall/heatshield", tile: (id: "r-wall", solid: true)),
        // Shuttles docked at the station, and walls the station can't touch.
        (path: "/turf/simulated/shuttle/floor", tile: (id: "floor")),
        (path: "/turf/simulated/shuttle/wall", tile: (id: "r-wall", solid: true)),
        (path: "/turf/unsimulated/wall", tile: (id: "r-wall", solid: true)),
        // A hole in the floor down to the deck below (`multiz.md`).
        (path: "/turf/simulated/floor/open", tile: (id: "open-space")),
    ],

    // A grille is solid, but air goes through it. Luna's windows are panes along the edges
    // of a tile, imported as objects (below); together they seal what Luna's do.
    grilles: ["/obj/structure/grille"],
    grille_tile: Some((id: "grille", solid: true, opaque: false, airtight: false)),

    objects: [
        (path: "/obj/machinery/door/airlock", id: "airlock", access_var: "req_access_txt", vars: ["id_tag"]),
        // Window panes lie along the edge of their tile they face (`windows.md`).
        (path: "/obj/structure/window", id: "window-pane", dir: true),
        (path: "/obj/structure/window_pod", id: "window-pane", dir: true),
        // Border firedoors seal the edge on the side they face (`firedoors.md`).
        (path: "/obj/machinery/door/firedoor/border_only", id: "firedoor", dir: true),
        // Window doors stand on the edge they face; with access, the map's icon state is
        // their look (`windoors.md`).
        (path: "/obj/machinery/door/window", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "left", "icon_state": "left"}),
        (path: "/obj/machinery/door/window/brigdoor", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state", "id"], type_vars: {"base_state": "leftsecure", "icon_state": "leftsecure"}),
        (path: "/obj/machinery/door/window/northleft", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "left", "icon_state": "left", "dir": "1"}),
        (path: "/obj/machinery/door/window/northright", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "right", "icon_state": "right", "dir": "1"}),
        (path: "/obj/machinery/door/window/southleft", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "left", "icon_state": "left", "dir": "2"}),
        (path: "/obj/machinery/door/window/southright", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "right", "icon_state": "right", "dir": "2"}),
        (path: "/obj/machinery/door/window/eastleft", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "left", "icon_state": "left", "dir": "4"}),
        (path: "/obj/machinery/door/window/eastright", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "right", "icon_state": "right", "dir": "4"}),
        (path: "/obj/machinery/door/window/westleft", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "left", "icon_state": "left", "dir": "8"}),
        (path: "/obj/machinery/door/window/westright", id: "windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "right", "icon_state": "right", "dir": "8"}),
        (path: "/obj/machinery/door/window/brigdoor/northleft", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "leftsecure", "icon_state": "leftsecure", "dir": "1"}),
        (path: "/obj/machinery/door/window/brigdoor/northright", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "rightsecure", "icon_state": "rightsecure", "dir": "1"}),
        (path: "/obj/machinery/door/window/brigdoor/southleft", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "leftsecure", "icon_state": "leftsecure", "dir": "2"}),
        (path: "/obj/machinery/door/window/brigdoor/southright", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "rightsecure", "icon_state": "rightsecure", "dir": "2"}),
        (path: "/obj/machinery/door/window/brigdoor/eastleft", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "leftsecure", "icon_state": "leftsecure", "dir": "4"}),
        (path: "/obj/machinery/door/window/brigdoor/eastright", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "rightsecure", "icon_state": "rightsecure", "dir": "4"}),
        (path: "/obj/machinery/door/window/brigdoor/westleft", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "leftsecure", "icon_state": "leftsecure", "dir": "8"}),
        (path: "/obj/machinery/door/window/brigdoor/westright", id: "brig-windoor", dir: true, access_var: "req_access_txt",
            vars: ["base_state", "icon_state"], type_vars: {"base_state": "rightsecure", "icon_state": "rightsecure", "dir": "8"}),
        // Wall fixtures face the room: the facing picks their side-on sprite, and an APC is
        // hung 24 pixels toward the wall it faces (`objects::spawn_object`).
        (path: "/obj/machinery/power/apc", id: "apc", dir: true),
        (path: "/obj/machinery/power/smes", id: "smes", vars: ["charge", "capacity", "chargelevel", "chargemode", "charging", "output", "online"]),
        (path: "/obj/machinery/power/terminal", id: "terminal", dir: true),
        // Cables keep their ends (Luna's icon state, "0-1" by default).
        (path: "/obj/cabling/power", id: "cable", ends_from_state: "0-1"),
        (path: "/obj/machinery/alarm", id: "air-alarm", dir: true),
        (path: "/obj/machinery/firealarm", id: "fire-alarm", dir: true),
        // Emergency wall lockers hang where their subtype puts them (`walllockers.md`).
        (path: "/obj/machinery/walllocker/emerglocker/north", id: "emergency-locker", dir: true,
            type_vars: {"dir": "2", "pixel_y": "32"}),
        (path: "/obj/machinery/walllocker/emerglocker/south", id: "emergency-locker", dir: true,
            type_vars: {"dir": "1", "pixel_y": "-32"}),
        (path: "/obj/machinery/walllocker/emerglocker/east", id: "emergency-locker", dir: true,
            type_vars: {"dir": "4", "pixel_x": "32"}),
        (path: "/obj/machinery/walllocker/emerglocker/west", id: "emergency-locker", dir: true,
            type_vars: {"dir": "8", "pixel_x": "-32"}),
        // Stools and beds (`chairs.md`).
        (path: "/obj/structure/stool", id: "stool"),
        (path: "/obj/structure/stool/barstool", id: "barstool"),
        (path: "/obj/structure/stool/bed", id: "bed"),

        // Atmos piping. Pieces keep Luna's direction, which decides the sides they join on.
        (path: "/obj/machinery/atmospherics/pipe/simple", id: "pipe", dir: true),
        (path: "/obj/machinery/atmospherics/pipe/manifold", id: "manifold", dir: true),
        (path: "/obj/machinery/atmospherics/pipe/tank/air", id: "air-tank", dir: true),
        (path: "/obj/machinery/atmospherics/pipe/tank/oxygen", id: "oxygen-pressure-tank", dir: true),
        (path: "/obj/machinery/atmospherics/pipe/tank/nitrogen", id: "nitrogen-pressure-tank", dir: true),
        (path: "/obj/machinery/atmospherics/pipe/tank/carbon_dioxide", id: "carbon-dioxide-pressure-tank", dir: true),
        (path: "/obj/machinery/atmospherics/pipe/tank/toxins", id: "plasma-pressure-tank", dir: true),
        (path: "/obj/machinery/atmospherics/unary/vent_pump", id: "vent", dir: true, vars: ["id"]),
        (path: "/obj/machinery/atmospherics/unary/vent_filter", id: "vent", dir: true),
        (path: "/obj/machinery/atmospherics/unary/vent_scrubber", id: "scrubber", dir: true),
        (path: "/obj/machinery/atmospherics/portables_connector", id: "connector", dir: true),
        (path: "/obj/machinery/atmospherics/pipe/vent", id: "pipe-vent", dir: true),
        (path: "/obj/machinery/atmospherics/unary/generator_input", id: "generator-input", dir: true),
        (path: "/obj/machinery/atmospherics/unary/thermal_plate", id: "thermal-plate", dir: true),
        (path: "/obj/machinery/atmospherics/unary/cold_sink/freezer", id: "freezer", dir: true),
        (path: "/obj/machinery/power/generator_type2", id: "teg", vars: ["transferpercent", "outputpercent"]),
        (path: "/obj/machinery/engine/supermatter", id: "supermatter"),
        (path: "/obj/machinery/engine/laser", id: "engine-laser", dir: true, vars: ["id"]),
        (path: "/obj/machinery/computer/lasercon", id: "laser-computer", vars: ["id"]),
        (path: "/obj/machinery/atmospherics/trinary/filter", id: "gas-filter", dir: true, vars: ["filter_type", "target_pressure", "on"]),
        // Gas pumps and mixers: off at one atmosphere unless the map says (`pipes.md`).
        (path: "/obj/machinery/atmospherics/binary/pump", id: "pump", dir: true, vars: ["on", "target_pressure"],
            type_vars: {"dir": "2", "on": "0", "target_pressure": "101.325"}),
        (path: "/obj/machinery/atmospherics/trinary/mixer", id: "gas-mixer", dir: true,
            vars: ["on", "target_pressure", "node1_concentration", "node2_concentration"],
            type_vars: {"dir": "2", "on": "0", "target_pressure": "101.325"}),
        (path: "/obj/machinery/atmospherics/unary/outlet_injector", id: "injector", dir: true, vars: ["volume_rate", "on"]),
        (path: "/obj/machinery/atmospherics/valve", id: "valve", dir: true),
        (path: "/obj/machinery/meter", id: "meter"),
        // Canisters. A canister on a connector port starts connected.
        (path: "/obj/machinery/portable_atmospherics/canister/air", id: "canister"),
        (path: "/obj/machinery/portable_atmospherics/canister/oxygen", id: "oxygen-canister"),
        (path: "/obj/machinery/portable_atmospherics/canister/nitrogen", id: "nitrogen-canister"),
        (path: "/obj/machinery/portable_atmospherics/canister/carbon_dioxide", id: "carbon-dioxide-canister"),
        (path: "/obj/machinery/portable_atmospherics/canister/toxins", id: "plasma-canister"),
        (path: "/obj/machinery/portable_atmospherics/canister/sleeping_agent", id: "nitrous-oxide-canister"),

        (path: "/obj/item/weapon/screwdriver", id: "screwdriver"),
        (path: "/obj/item/weapon/wrench", id: "wrench"),
        (path: "/obj/item/weapon/crowbar", id: "crowbar"),
        (path: "/obj/item/weapon/wirecutters", id: "wirecutters"),
        (path: "/obj/item/device/multitool", id: "multitool"),
        (path: "/obj/item/weapon/weldingtool", id: "welder"),
        (path: "/obj/item/device/flashlight", id: "flashlight"),
        (path: "/obj/item/device/flashlight/pen", id: "penlight"),
        (path: "/obj/item/device/flashlight/lantern", id: "lantern"),
        (path: "/obj/item/device/flashlight/lamp", id: "desk-lamp"),
        (path: "/obj/item/device/flashlight/lamp/green", id: "desk-lamp-green"),
        (path: "/obj/structure/reagent_dispensers/fueltank", id: "fuel-tank"),
        (path: "/obj/structure/reagent_dispensers/watertank", id: "water-tank"),
        // Paperwork (`paperwork.md`) and status displays (`status-displays.md`).
        (path: "/obj/item/weapon/paper_bin", id: "paper-bin"),
        (path: "/obj/item/weapon/paper", id: "paper", vars: ["name", "info"]),
        // Filing cabinets take the sheets on their tile (`filing-cabinets.md`).
        (path: "/obj/structure/filingcabinet", id: "filing-cabinet"),
        (path: "/obj/structure/filingcabinet/chestdrawer", id: "chest-drawer"),
        // Linen bins and bedsheets (`bedsheets.md`).
        (path: "/obj/structure/bedsheetbin", id: "linen-bin"),
        // Space heaters, a full cell in each (`space-heaters.md`).
        (path: "/obj/machinery/space_heater", id: "space-heater"),
        // Morgue drawers; their trays slide out east (`morgue.md`).
        (path: "/obj/structure/morgue", id: "morgue"),
        // Crematoriums, their trays sliding out south, and the igniters that light them by id.
        (path: "/obj/structure/crematorium", id: "crematorium", vars: ["id"]),
        (path: "/obj/machinery/crema_switch", id: "crematorium-igniter", vars: ["id"]),
        // Conveyor belts and their switches, joined by id (`conveyors.md`).
        (path: "/obj/machinery/conveyor", id: "conveyor", dir: true, vars: ["id"]),
        (path: "/obj/machinery/conveyor/centcom_auto", id: "conveyor", dir: true, vars: ["id", "is_on"],
            type_vars: {"is_on": "1"}),
        (path: "/obj/machinery/conveyor_switch", id: "conveyor-switch", vars: ["id"]),
        (path: "/obj/machinery/conveyor_switch/oneway", id: "conveyor-switch", vars: ["id", "oneway"],
            type_vars: {"oneway": "1"}),
        (path: "/obj/item/weapon/bedsheet", id: "bedsheet"),
        (path: "/obj/item/weapon/bedsheet/blue", id: "bedsheet-blue"),
        (path: "/obj/item/weapon/bedsheet/brown", id: "bedsheet-brown"),
        (path: "/obj/item/weapon/bedsheet/captain", id: "bedsheet-captain"),
        (path: "/obj/item/weapon/bedsheet/hop", id: "bedsheet-hop"),
        (path: "/obj/item/weapon/bedsheet/medical", id: "bedsheet-medical"),
        (path: "/obj/item/weapon/bedsheet/rd", id: "bedsheet-rd"),
        (path: "/obj/item/weapon/caution", id: "caution"),
        (path: "/obj/item/weapon/pen", id: "pen"),
        (path: "/obj/item/weapon/pen/blue", id: "pen-blue"),
        (path: "/obj/item/weapon/pen/red", id: "pen-red"),
        (path: "/obj/item/weapon/clipboard", id: "clipboard"),
        (path: "/obj/machinery/status_display", id: "status-display", vars: ["mode"]),
        // Security cameras and their consoles (`cameras.md`).
        (path: "/obj/machinery/camera", id: "camera", dir: true, vars: ["c_tag", "network"]),
        (path: "/obj/machinery/computer/security", id: "security-console"),
        // Vending machines (`vending.md`).
        (path: "/obj/machinery/vending_tg/coffee", id: "vending-coffee"),
        (path: "/obj/machinery/vending_tg/snack", id: "vending-snack"),
        (path: "/obj/machinery/vending_tg/cola", id: "vending-cola"),
        (path: "/obj/machinery/vending_tg/cola/soda", id: "vending-soda"),
        (path: "/obj/machinery/vending_tg/cigarette", id: "vending-cigarette"),
        // Portable air pumps and scrubbers (`portables.md`).
        (path: "/obj/machinery/portable_atmospherics/pump", id: "portable-pump"),
        (path: "/obj/machinery/portable_atmospherics/scrubber", id: "portable-scrubber"),
        (path: "/obj/item/weapon/extinguisher", id: "fire-extinguisher"),
        (path: "/obj/item/weapon/extinguisher/mini", id: "fire-extinguisher-mini"),
        (path: "/obj/structure/extinguisher_cabinet", id: "extinguisher-cabinet"),

        // Tables keep the look the mapper chose: an icon state and a direction.
        (path: "/obj/structure/table", id: "table", dir: true, state: Some("table")),
        (path: "/obj/structure/table/reinforced", id: "table-reinforced", dir: true, state: Some("reinf_table")),
        (path: "/obj/structure/table/woodentable", id: "table-wood", dir: true, state: Some("wood_table")),
        (path: "/obj/structure/rack", id: "rack"),
        (path: "/obj/item/stack/sheet/metal", id: "metal-sheet"),
        (path: "/obj/item/stack/sheet/glass", id: "glass-sheet"),
        (path: "/obj/item/stack/sheet/mineral/plasma", id: "plasma-sheet"),
        (path: "/obj/machinery/power/port_gen/pacman", id: "pacman"),
        (path: "/obj/structure/dispenser/oxygen", id: "tank-dispenser"),
        (path: "/obj/machinery/cell_charger", id: "cell-charger"),
        (path: "/obj/machinery/power/monitor", id: "power-monitor"),
        (path: "/obj/structure/stool/bed/chair", id: "chair", dir: true),
        (path: "/obj/structure/stool/bed/chair/comfy/brown", id: "comfy-chair-brown", dir: true),
        (path: "/obj/item/device/radio", id: "radio"),
        (path: "/obj/item/device/radio/intercom", id: "intercom"),
        (path: "/obj/item/device/radio/headset/headset_eng", id: "headset-eng"),
        (path: "/obj/item/clothing/glasses/meson", id: "meson-glasses"),
        // A tracking beacon is a radio subtype but no radio; nothing to make of it yet.
        (path: "/obj/item/device/radio/beacon"),
        (path: "/obj/item/weapon/tank/jetpack", id: "jetpack"),
        (path: "/obj/item/weapon/tank/jetpack/ce", id: "jetpack-ce"),
        (path: "/obj/item/weapon/cell", id: "power-cell"),
        (path: "/obj/item/weapon/cell/high", id: "high-power-cell"),
        (path: "/obj/item/clothing/gloves/yellow", id: "insulated-gloves"),
        (path: "/obj/item/clothing/mask/breath", id: "breath-mask"),
        (path: "/obj/item/weapon/storage/firstaid/regular", id: "first-aid-kit"),
        (path: "/obj/item/weapon/storage/firstaid/fire", id: "first-aid-kit-fire"),
        (path: "/obj/item/stack/medical/bruise_pack", id: "bruise-pack"),
        (path: "/obj/item/stack/medical/ointment", id: "ointment"),
        (path: "/obj/item/device/healthanalyzer", id: "health-analyzer"),

        (path: "/obj/item/clothing/mask/gas", id: "gas-mask"),
        (path: "/obj/item/clothing/shoes/magnetic", id: "magboots"),
        (path: "/obj/item/clothing/gloves/black", id: "black-gloves"),
        (path: "/obj/item/clothing/suit/fire", id: "firesuit"),
        (path: "/obj/item/clothing/head/helmet/hardhat", id: "hardhat"),
        (path: "/obj/item/clothing/head/helmet/hardhat/orange", id: "hardhat-orange"),
        (path: "/obj/item/clothing/head/helmet/hardhat/red", id: "hardhat-red"),
        (path: "/obj/item/clothing/head/helmet/hardhat/white", id: "hardhat-white"),
        (path: "/obj/item/clothing/head/helmet/hardhat/dblue", id: "hardhat-blue"),
        (path: "/obj/item/clothing/suit/space/rig", id: "space-suit"),
        (path: "/obj/item/clothing/head/helmet/space/rig", id: "space-helmet"),
        (path: "/obj/item/weapon/tank/oxygen", id: "oxygen-tank"),

        // Containers come with their tools inside (luna:code/game/objects/storage).
        (path: "/obj/item/weapon/cable_coil", id: "cable-coil"),
        (path: "/obj/item/weapon/storage/toolbox/mechanical", id: "toolbox-mechanical"),
        (path: "/obj/item/weapon/storage/toolbox/electrical", id: "toolbox-electrical"),
        (path: "/obj/item/weapon/storage/belt/utility", id: "utility-belt"),
        (path: "/obj/item/weapon/storage/belt/utility/loaded", id: "utility-belt-loaded"),
        (path: "/obj/item/weapon/storage/belt/utility/loaded/full", id: "utility-belt-full"),
        (path: "/obj/item/weapon/storage/box/light/tubes", id: "light-tubes-box"),
        (path: "/obj/item/weapon/storage/box/light/bulb", id: "light-bulbs-box"),

        // Lights face the wall they hang on, and keep Luna's colours (`lighting.md`).
        (path: "/obj/machinery/light", id: "light", dir: true),
        (path: "/obj/machinery/light/blue", id: "light-blue", dir: true),
        (path: "/obj/machinery/light/red", id: "light-red", dir: true),
        (path: "/obj/machinery/light/small", id: "light-small", dir: true),
        (path: "/obj/machinery/light/small/red", id: "light-small-red", dir: true),
        (path: "/obj/machinery/light_switch", id: "light-switch"),

        // Closets, lockers and crates come with what Luna puts in them (`closets.md`). No
        // rule for the plain closet: it would catch every other kind.
        (path: "/obj/structure/closet/emcloset", id: "closet-emergency"),
        (path: "/obj/structure/closet/toolcloset", id: "closet-tools"),
        (path: "/obj/structure/closet/firecloset", id: "closet-fire"),
        (path: "/obj/structure/closet/secure_closet/engineering_chief", id: "locker-chief-engineer"),
        (path: "/obj/structure/closet/secure_closet/engineering_electrical", id: "locker-electrical"),
        (path: "/obj/structure/closet/secure_closet/engineering_welding", id: "locker-welding"),
        (path: "/obj/structure/closet/secure_closet/engineering_personal", id: "locker-engineer"),
        (path: "/obj/structure/closet/coffin", id: "closet-coffin"),
        (path: "/obj/structure/closet/secure_closet/personal", id: "locker-personal"),
        (path: "/obj/structure/closet/secure_closet/brig", id: "locker-brig"),
        (path: "/obj/structure/closet/secure_closet/security", id: "locker-security"),
        (path: "/obj/structure/closet/crate", id: "crate"),
        (path: "/obj/structure/closet/crate/internals", id: "crate-internals"),
        (path: "/obj/structure/closet/crate/radiation", id: "crate-radiation"),
        (path: "/obj/structure/closet/crate/rcd", id: "crate-rcd"),

        // Burn chambers and incinerators (`igniters.md`, `blast-doors.md`).
        (path: "/obj/machinery/igniter", id: "igniter", vars: ["id", "on"]),
