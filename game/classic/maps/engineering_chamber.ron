// The first-milestone test map. Top row first, as seen on screen.
// Legend ids are tile prototype ids; `objects` are object prototype ids.
// Space surrounds the station. An engineering equipment closet on the east side sits
// behind an airlock that needs `engine_equip` access. Two ID cards lie in the room:
// an engineer's (opens it) and an assistant's (does not). The closet's east wall has an
// external airlock to space (`external_airlocks` access).
(
    legend: {
        ' ': (tile: (id: "space")),
        '#': (tile: (id: "wall", solid: true)),
        '.': (tile: (id: "floor")),
        'S': (tile: (id: "floor"), spawn: true),
        'A': (tile: (id: "floor"), objects: [(id: "airlock", access: ["engine_equip"])]),
        // Luna's Engineer and Unassigned job access (luna:code/game/jobs/access.dm).
        'i': (tile: (id: "floor"), objects: [(id: "id-card", access: ["engine", "engine_equip", "tech_storage", "maint_tunnels", "external_airlocks"])]),
        'a': (tile: (id: "floor"), objects: [(id: "id-card", access: ["maint_tunnels"])]),
        // Atmospherics: an air tank feeds a pump into the distribution pipe along the north
        // wall, with vents in the room and the closet, a canister on a connector port and a
        // manual valve. A scrubber in the south dumps into its own short waste pipe.
        'T': (tile: (id: "floor"), objects: ["air-tank"]),
        'P': (tile: (id: "floor"), objects: [(id: "pump", dir: East)]),
        'p': (tile: (id: "floor"), objects: ["pipe"]),
        'v': (tile: (id: "floor"), objects: ["pipe", "vent"]),
        'K': (tile: (id: "floor"), objects: ["pipe", "connector", "canister"]),
        'V': (tile: (id: "floor"), objects: ["valve"]),
        '|': (tile: (id: "wall", solid: true), objects: ["pipe"]),
        's': (tile: (id: "floor"), objects: ["pipe", "scrubber"]),
        // Power: a SMES in the north-west corner feeds a cable along the row below the
        // pipes, through the wall into the closet. Each area's APC sits on a wall at one
        // end of it. The cable runs east-west, so its ends reach both APCs and the SMES.
        'B': (tile: (id: "floor"), objects: ["smes", (id: "cable", ends: [West, East])]),
        '-': (tile: (id: "floor"), objects: [(id: "cable", ends: [West, East])]),
        'Z': (tile: (id: "floor"), spawn: true, objects: [(id: "cable", ends: [West, East])]),
        'O': (tile: (id: "floor"), objects: ["oxygen-tank", (id: "cable", ends: [West, East])]),
        '=': (tile: (id: "wall", solid: true), objects: [(id: "cable", ends: [West, East])]),
        'Q': (tile: (id: "wall", solid: true), objects: ["apc"]),
        // EVA gear in the closet: space suit, helmet, breath mask, emergency oxygen.
        'U': (tile: (id: "floor"), objects: ["space-suit"]),
        'H': (tile: (id: "floor"), objects: ["space-helmet"]),
        'M': (tile: (id: "floor"), objects: ["breath-mask"]),
        'e': (tile: (id: "floor"), objects: ["emergency-oxygen"]),
        // External airlock from the closet straight to space.
        'E': (tile: (id: "floor"), objects: [(id: "airlock", access: ["external_airlocks"])]),
        'c': (tile: (id: "floor"), objects: ["crowbar"]),
        'w': (tile: (id: "floor"), objects: ["wrench"]),
        'd': (tile: (id: "floor"), objects: ["screwdriver"]),
        'x': (tile: (id: "floor"), objects: ["wirecutters"]),
        'o': (tile: (id: "floor"), objects: ["oxygen-tank"]),
        'm': (tile: (id: "floor"), objects: ["metal-sheet"]),
        'u': (tile: (id: "floor"), objects: ["multitool"]),
        'g': (tile: (id: "floor"), objects: ["insulated-gloves"]),
        // An air alarm on the wall of each area, watching the floor tile beside it.
        'L': (tile: (id: "wall", solid: true), objects: ["air-alarm"]),
    },
    // Areas: each one is powered by its own APC.
    area_legend: { 'e': "engineering", 's': "eng-storage" },
    area_rows: [
        "                      ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        " eeeeeeeeeeeeeeeessss ",
        "                      ",
    ],
    rows: [
        "                      ",
        " #################### ",
        " #TPvpKpppvppVpp|pv.# ",
        " QBZ----------Z-=-O-Q ",
        " #..............#U.H# ",
        " #.....####.....#M.e# ",
        " #..w..#..#.....A.m.E ",
        " L.....#..#..d..#...# ",
        " #.......a...i.u#...# ",
        " #.S..........S.#.c.L ",
        " #...x..spp...g.#...# ",
        " #################### ",
        "                      ",
    ],
)
