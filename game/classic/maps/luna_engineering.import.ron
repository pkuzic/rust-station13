// Rules for importing NSV Luna's engineering section (deck 2) with rs13-dmm-import:
//
//   cargo run -p rs13-dmm-import -- ../luna/maps/NSV_Luna.dmm \
//       game/classic/maps/luna_engineering.import.ron game/classic/maps/luna_engineering.ron
//
// Luna types without a prototype yet are skipped and listed at the top of the output.
// Luna's filters, injectors and the engine's cooling machines have no prototype yet, so
// the pipes that join them end there.
// Spec: docs/reference/map-import.md.
(
    base: "luna_common.import.ron",
    source: "NSV Luna (github.com/SS13/luna, commit e13cf12) maps/NSV_Luna.dmm",
    z: 2,
    // The engineering block: engine hallway, control, monitoring and core, electrical
    // storage and the Chief Engineer's office.
    columns: (23, 56),
    rows: (56, 80),

    // Luna's Engineer start points. Until jobs exist, an engineer's ID card lies on each
    // (Luna's Engineer access, luna:code/game/jobs/access.dm).
    spawns: [
        (path: "/obj/effect/landmark/start", with: [
            (id: "id-card", access: ["engine", "engine_equip", "tech_storage", "maint_tunnels", "external_airlocks"]),
            // Luna gives engineers an engineering headset.
            (id: "headset-eng"),
        ]),
    ],

    areas: {
        "/area/engine/engine_hallway": "engine-hallway",
        "/area/engine/engine_control": "engine-control",
        "/area/engine/engine_mon": "engine-monitoring",
        "/area/engine/combustion": "engine-combustion",
        "/area/engine/engine_walls": "engine-walls",
        "/area/storage/electrical": "electrical-storage",
        "/area/crew_quarters/chief": "chief-engineer",
        "/area/maintenance/fsmaint3": "maint-fore-starboard",
        "/area/maintenance/starboard1": "maint-starboard",
        "/area/maintenance/port3": "maint-port",
        "/area/maintenance/pmaintcentral3": "maint-port-central",
        "/area/shieldgen": "shield-generation",
        "/area/hangar/escape/crew": "escape-hangar",
    },

)
