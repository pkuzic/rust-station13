// Item prototypes. Each id is also its sprite id and its noun id in the locales.
//
// force:     brute damage when hitting someone with it (Luna values, docs/reference/health.md)
// size:      Luna `w_class`, 1 tiny … 5 huge (default 3, Luna's default); what fits where
// slot:      where it can be worn (docs/reference/equipment.md)
// slowdown:  added to the wearer's movement delay, deciseconds (Luna: space suit 3, shoes -1)
// space:     a space suit or helmet; both together seal the wearer against vacuum
// internals: a mask that can be connected to a gas tank
// tank:      a gas tank: volume L, pressure kPa, gas
// siemens:   gloves: share of an electric shock that gets through (default 1; insulated 0)
// storage:   a container (docs/reference/storage.md); `holds` limits it to those ids
// contents:  what a container starts with (Luna's container `New()`)
// base:      looks like and is called this other prototype (a loaded belt is a belt)
// stack:     piles up to this many in one item; new ones are full
// conducts:  electricity goes through it (Luna `CONDUCT`): metal tools
[
    (id: "crowbar", force: 5.0, size: 2, conducts: true),
    (id: "wrench", force: 5.0, size: 2, conducts: true),
    (id: "screwdriver", force: 5.0, size: 1, conducts: true),
    (id: "wirecutters", force: 6.0, size: 2, conducts: true),
    (id: "multitool", force: 5.0, size: 2, conducts: true),
    // Luna: 30 units of fuel; lit, it burns for 15 (`welding.md`).
    (id: "welder", force: 3.0, size: 2, conducts: true),
    // Fire extinguishers (luna:code/game/objects/items.dm, `extinguishers.md`).
    (id: "fire-extinguisher", force: 12.0, size: 3, conducts: true),
    (id: "fire-extinguisher-mini", force: 3.0, size: 2),
    // Luna: 30 lengths, w_class 1.5 (we have whole sizes: it fits where size 2 does).
    (id: "cable-coil", force: 0.0, size: 2, stack: 30),
    (id: "metal-sheet", force: 5.0),
    // Luna `device/radio`: a walkie-talkie on the common channel, worn on the belt (`radio.md`).
    (id: "radio", force: 0.0, size: 2, slot: "belt", conducts: true),
    // Luna `radio/headset/headset_eng`: a radio worn on the ears; `;` talks into it.
    (id: "headset-eng", force: 0.0, size: 1, slot: "ears", conducts: true),
    // Luna `glasses/meson`.
    (id: "meson-glasses", force: 0.0, size: 1, slot: "glasses"),
    // Luna `weapon/cell`: 2 500 units, or 10 000 for the high-capacity one (`cells.md`).
    (id: "power-cell", force: 5.0, conducts: true),
    (id: "high-power-cell", force: 5.0, conducts: true),
    // Luna `sheet/mineral/plasma`: up to 50; fuel for the P.A.C.M.A.N. (`generators.md`).
    (id: "plasma-sheet", force: 5.0, stack: 50),
    // Luna `table_rack_parts.dm`.
    (id: "table-parts", force: 0.0),
    (id: "table-parts-reinforced", force: 0.0),
    (id: "table-parts-wood", force: 0.0),
    (id: "rack-parts", force: 0.0),
    // Luna `stack/tile/metal`: up to 60, w_class 3.
    (id: "floor-tile", force: 6.0, size: 3, stack: 60),
    (id: "id-card", force: 0.0, size: 1, slot: "id"),
    // Luna: 70 L of pure oxygen at 6 atm, worn on the back.
    (id: "oxygen-tank", force: 5.0, slot: "back", tank: (volume: 70.0, pressure: 607.95, gas: "oxygen")),
    // Luna: 15 L at 2 atm, worn on the belt.
    (id: "emergency-oxygen", force: 7.0, size: 2, slot: "belt", tank: (volume: 15.0, pressure: 202.65, gas: "oxygen")),
    // Luna `tank/jetpack`: an oxygen tank like the big one, worn on the back; w_class 4.
    (id: "jetpack", force: 5.0, size: 4, slot: "back", tank: (volume: 70.0, pressure: 607.95, gas: "oxygen")),
    (id: "jetpack-ce", force: 5.0, size: 4, slot: "back", tank: (volume: 70.0, pressure: 607.95, gas: "oxygen")),
    (id: "grey-jumpsuit", force: 0.0, slot: "uniform"),
    (id: "black-shoes", force: 0.0, slot: "shoes", slowdown: -1.0),
    (id: "insulated-gloves", force: 0.0, size: 2, slot: "gloves", siemens: 0.0),
    (id: "breath-mask", force: 0.0, size: 2, slot: "mask", internals: true),
    (id: "space-suit", force: 0.0, size: 4, slot: "suit", slowdown: 3.0, space: true),
    (id: "space-helmet", force: 0.0, slot: "head", space: true),

    // Engineering gear (`docs/reference/equipment.md`). Magnetic boots hold to the floor
    // against space wind; hard hats have a lamp, switched in hand (`flashlights.md`);
    // black gloves are Luna's plain gloves, letting half a shock through.
    (id: "magboots", force: 0.0, slot: "shoes", slowdown: -1.0, magnetic: true, conducts: true),
    (id: "black-gloves", force: 0.0, size: 2, slot: "gloves", siemens: 0.5),
    (id: "gas-mask", force: 0.0, slot: "mask", internals: true),
    (id: "firesuit", force: 0.0, size: 4, slot: "suit", slowdown: 1.0),
    (id: "hardhat", force: 0.0, slot: "head"),
    (id: "hardhat-orange", force: 0.0, slot: "head"),
    (id: "hardhat-red", force: 0.0, slot: "head"),
    (id: "hardhat-white", force: 0.0, slot: "head"),
    (id: "hardhat-blue", force: 0.0, slot: "head"),

    // Lights (luna:code/modules/power/lighting.dm). A tube or bulb shows its state:
    // "" works, "burned", "broken" (`docs/reference/lights.md`).
    (id: "light-tube", force: 2.0, size: 2),
    (id: "light-bulb", force: 2.0, size: 2),
    (id: "light-tubes-box", force: 0.0, storage: (),
        contents: ["light-tube", "light-tube", "light-tube", "light-tube", "light-tube", "light-tube", "light-tube"]),
    (id: "light-bulbs-box", force: 0.0, storage: (),
        contents: ["light-bulb", "light-bulb", "light-bulb", "light-bulb", "light-bulb", "light-bulb", "light-bulb"]),

    // Hand-held lights (luna:code/game/objects/items/devices/flashlight2.dm), lit by
    // using them in hand (`docs/reference/flashlights.md`). Desk lamps start lit.
    (id: "flashlight", force: 0.0, size: 2, slot: "belt", conducts: true),
    (id: "penlight", force: 0.0, size: 2, slot: "belt", conducts: true),
    (id: "lantern", force: 0.0, size: 2, slot: "belt", conducts: true),
    (id: "desk-lamp", force: 0.0, size: 4, conducts: true),
    (id: "desk-lamp-green", force: 0.0, size: 4, conducts: true),

    // Medical (luna:code/game/objects/items/stacks/medical.dm, storage/firstaid.dm,
    // devices/scanners.dm; `docs/reference/medical.md`). Luna's kits also carry band-aids,
    // syringes and pills, which have no prototype yet.
    (id: "bruise-pack", force: 0.0, size: 1, stack: 10),
    (id: "ointment", force: 0.0, size: 1, stack: 10),
    (id: "health-analyzer", force: 0.0, size: 1, slot: "belt", conducts: true),
    (id: "first-aid-kit", force: 0.0, storage: (),
        contents: ["bruise-pack", "bruise-pack", "ointment", "ointment", "health-analyzer"]),
    (id: "first-aid-kit-fire", force: 0.0, storage: (),
        contents: ["ointment", "ointment", "health-analyzer"]),

    // Containers (luna:code/game/objects/storage/toolbox.dm, belts.dm). Luna's analyzers
    // and scanners have no prototype yet and are left out. Luna's electrical
    // toolbox swaps its third coil for insulated gloves one time in ten; ours always has
    // the coil.
    (id: "toolbox-mechanical", force: 10.0, size: 4, storage: (),
        contents: ["screwdriver", "wrench", "welder", "crowbar", "wirecutters"]),
    // Luna's emergency toolbox has a red crowbar, a mini welding tool and a flare half the
    // time; ours has the plain crowbar, welding tool and always a flashlight.
    (id: "toolbox-emergency", force: 10.0, size: 4, storage: (),
        contents: ["crowbar", "welder", "fire-extinguisher-mini", "flashlight", "radio"]),
    (id: "toolbox-electrical", force: 10.0, size: 4, storage: (),
        contents: ["screwdriver", "wirecutters", "crowbar", "cable-coil", "cable-coil", "cable-coil"]),
    (id: "utility-belt", force: 0.0, slot: "belt",
        storage: (holds: ["crowbar", "screwdriver", "wirecutters", "wrench", "multitool", "cable-coil", "welder", "flashlight", "penlight", "lantern"])),
    (id: "utility-belt-loaded", base: "utility-belt", force: 0.0, slot: "belt",
        storage: (holds: ["crowbar", "screwdriver", "wirecutters", "wrench", "multitool", "cable-coil", "welder", "flashlight", "penlight", "lantern"]),
        contents: ["screwdriver", "wrench", "welder", "crowbar", "wirecutters", "cable-coil"]),
    (id: "utility-belt-full", base: "utility-belt", force: 0.0, slot: "belt",
        storage: (holds: ["crowbar", "screwdriver", "wirecutters", "wrench", "multitool", "cable-coil", "welder", "flashlight", "penlight", "lantern"]),
        contents: ["screwdriver", "wrench", "welder", "crowbar", "wirecutters", "cable-coil", "multitool"]),

    // Food and drink (`food.md`); what they hold is in `food.rs`.
    (id: "candy", force: 0.0, size: 1),
    (id: "chips", force: 0.0, size: 1),
    (id: "beef-jerky", force: 0.0, size: 1),
    (id: "no-raisin", force: 0.0, size: 1),
    (id: "space-twinkie", force: 0.0, size: 1),
    (id: "cheesie-honkers", force: 0.0, size: 1),
    (id: "trash-candy", force: 0.0, size: 1),
    (id: "trash-chips", force: 0.0, size: 1),
    (id: "trash-sosjerky", force: 0.0, size: 1),
    (id: "trash-raisins", force: 0.0, size: 1),
    (id: "trash-cheesie", force: 0.0, size: 1),
    (id: "coffee", force: 0.0, size: 1),
    (id: "tea", force: 0.0, size: 1),
    (id: "hot-chocolate", force: 0.0, size: 1),
    (id: "dry-ramen", force: 0.0, size: 1),
    (id: "cola", force: 0.0, size: 1),
    (id: "space-mountain-wind", force: 0.0, size: 1),
    (id: "dr-gibb", force: 0.0, size: 1),
    (id: "starkist", force: 0.0, size: 1),
    (id: "space-up", force: 0.0, size: 1),
    // Smoking (`smoking.md`).
    (id: "cigarette-packet", force: 0.0, size: 1, slot: "belt"),
    (id: "matchbox", force: 0.0, size: 2, slot: "belt", storage: (holds: ["match"]),
        contents: ["match", "match", "match", "match", "match", "match", "match"]),
    (id: "match", force: 0.0, size: 1),
    (id: "lighter", force: 0.0, size: 1, slot: "belt"),
    (id: "cigarette", force: 0.0, size: 1, slot: "mask"),
    (id: "cigarette-butt", force: 0.0, size: 1),
    // Paperwork (`paperwork.md`).
    (id: "paper-bin", force: 0.0, size: 3),
    (id: "paper", force: 0.0, size: 1),
    (id: "pen", force: 0.0, size: 1, slot: "belt"),
    (id: "pen-blue", force: 0.0, size: 1, slot: "belt"),
    (id: "pen-red", force: 0.0, size: 1, slot: "belt"),
    (id: "clipboard", force: 0.0, size: 2, slot: "belt"),
    // Bedsheets (Luna `bedsheet` and its colours, `bedsheets.md`).
    (id: "bedsheet", force: 0.0, size: 1),
    (id: "bedsheet-blue", force: 0.0, size: 1),
    (id: "bedsheet-brown", force: 0.0, size: 1),
    (id: "bedsheet-captain", force: 0.0, size: 1),
    (id: "bedsheet-hop", force: 0.0, size: 1),
    (id: "bedsheet-medical", force: 0.0, size: 1),
    (id: "bedsheet-rd", force: 0.0, size: 1),
    // Luna `weapon/caution`: "Caution! Wet Floor!".
    (id: "caution", force: 1.0, size: 3),
    // Luna `stack/sheet/glass`: up to 50 (building windows from it isn't built yet).
    (id: "glass-sheet", force: 5.0, stack: 50),
    // Luna `weapon/urn`: what a crematorium leaves of someone.
    (id: "urn", force: 0.0, size: 3),
    (id: "circuit-board", force: 0.0, size: 2),
    (id: "flash", force: 0.0, size: 1),
    (id: "donk-pocket", force: 0.0, size: 1),
    (id: "burnt-mess", force: 0.0, size: 1),
    (id: "donk-pockets", force: 0.0, storage: (),
        contents: ["donk-pocket", "donk-pocket", "donk-pocket", "donk-pocket", "donk-pocket", "donk-pocket"]),
    (id: "sunglasses", force: 0.0, size: 1, slot: "glasses"),
]
