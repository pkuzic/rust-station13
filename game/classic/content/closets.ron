// Closets, lockers and crates (luna:code/game/objects/structures/crates_lockers,
// code/defines/obj/closet.dm). Each id is also its sprite id and its noun id.
//
// crate:     a crate: stays dense when open, takes only items, can't be welded
// closed:    its sprite state when closed; open: when open
// locked:    a secure locker: its sprite state when locked; it starts locked
// access:    a secure locker: the access ids that work its lock (any one is enough)
// contents:  what it starts with (Luna's `New()`). `chance` is in percent (default 100);
//            `or` is what it gets instead when the roll fails.
//
// Luna's contents without a prototype here yet are left out: backpacks, jumpsuits, shoes,
// hard hats, welding helmets, industrial welding tools, meson glasses, gas masks, PDAs,
// headsets, flashes, flashlights, T-ray scanners, first-aid kits,
// air tanks, radiation suits and the RCD.
[
    (id: "closet", closed: "closed", open: "open"),
    // Luna `closet/syndicate/personal` and `nuclear`; what isn't built yet is left out.
    (id: "closet-syndicate-personal", closed: "syndicate1", open: "syndicate1open", contents: [
        (id: "jetpack-syndie"), (id: "breath-mask"), (id: "syndicate-jumpsuit"), (id: "terror-helmet"),
        (id: "terror-suit"), (id: "power-cell"),
    ]),
    (id: "closet-syndicate-nuclear", closed: "syndicate", open: "syndicateopen", contents: [
        (id: "handcuffs-box"), (id: "energy-gun"), (id: "energy-gun"), (id: "energy-gun"),
        (id: "pinpointer"), (id: "pinpointer"), (id: "pinpointer"), (id: "uplink-radio"),
    ]),
    // Luna `emcloset`: an engineering oxygen tank one time in ten; ours is always the
    // plain emergency one.
    (id: "closet-emergency", closed: "emergency", open: "emergencyopen", contents: [
        (id: "emergency-oxygen"), (id: "breath-mask"),
        (id: "emergency-oxygen"), (id: "breath-mask"),
        (id: "emergency-oxygen"), (id: "breath-mask"),
    ]),
    (id: "closet-fire", closed: "firecloset", open: "fireclosetopen", contents: [
        (id: "toolbox-emergency"), (id: "toolbox-emergency"),
        (id: "fire-extinguisher"), (id: "fire-extinguisher"),
    ]),
    (id: "closet-tools", closed: "toolcloset", open: "toolclosetopen", contents: [
        (id: "insulated-gloves", chance: 10.0),
        (id: "utility-belt", chance: 20.0),
        (id: "multitool", chance: 30.0),
        (id: "toolbox-mechanical", chance: 80.0, or: Some("toolbox-electrical")),
        (id: "cable-coil", chance: 50.0),
        (id: "hardhat", chance: 30.0),
        (id: "wrench"), (id: "wirecutters"), (id: "screwdriver"), (id: "crowbar"),
        (id: "flashlight"),
    ]),

    // The rest of the closets and lockers on Luna's decks (`closets.md`).
    (id: "closet-bio-science", closed: "bio", open: "bioopen", contents: [(id: "white-shoes"), (id: "latex-gloves")]),
    (id: "closet", closed: "closed", open: "open"),
    (id: "wardrobe-green", closed: "green", open: "open", contents: [(id: "green-shoes"), (id: "green-shoes"), (id: "green-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes")]),
    (id: "wardrobe-black", closed: "black", open: "open", contents: [(id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "top-hat"), (id: "top-hat"), (id: "top-hat")]),
    (id: "wardrobe-grey", closed: "grey", open: "open", contents: [(id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes")]),
    (id: "wardrobe-mixed", closed: "mixed", open: "open", contents: [(id: "brown-shoes"), (id: "brown-shoes"), (id: "brown-shoes"), (id: "brown-shoes"), (id: "black-shoes"), (id: "brown-shoes"), (id: "white-shoes")]),
    (id: "wardrobe-red", closed: "red", open: "open", contents: [(id: "brown-shoes"), (id: "brown-shoes"), (id: "brown-shoes"), (id: "jackboots"), (id: "jackboots"), (id: "jackboots"), (id: "beret"), (id: "beret"), (id: "beret")]),
    (id: "wardrobe-pink", closed: "pink", open: "open", contents: [(id: "brown-shoes"), (id: "brown-shoes"), (id: "brown-shoes"), (id: "brown-shoes"), (id: "brown-shoes"), (id: "brown-shoes")]),
    (id: "wardrobe-orange", closed: "orange", open: "open"),
    (id: "wardrobe-hydroponics", closed: "green", open: "open", contents: [(id: "black-shoes"), (id: "black-shoes")]),
    (id: "wardrobe-chapel", closed: "closed", open: "open", contents: [(id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes")]),
    (id: "wardrobe-bar", closed: "black", open: "open", contents: [(id: "top-hat"), (id: "top-hat"), (id: "black-shoes"), (id: "black-shoes")]),
    (id: "wardrobe-atmospherics", closed: "yellow", open: "open", contents: [(id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes"), (id: "headset-eng"), (id: "headset-eng"), (id: "headset-eng"), (id: "black-shoes"), (id: "black-shoes"), (id: "black-shoes")]),
    (id: "wardrobe-toxins", closed: "white", open: "open", contents: [(id: "white-shoes"), (id: "white-shoes"), (id: "white-shoes"), (id: "white-shoes"), (id: "radio"), (id: "radio"), (id: "radio"), (id: "white-shoes"), (id: "white-shoes"), (id: "white-shoes")]),
    (id: "locker-scientist", closed: "secureres", open: "secureresopen", locked: "secureres1", access: ["tox_storage"], contents: [(id: "oxygen-tank"), (id: "gas-mask"), (id: "white-shoes"), (id: "latex-gloves"), (id: "radio")]),
    (id: "locker-doctor", closed: "securemed", open: "securemedopen", locked: "securemed1", access: ["medical"]),
    (id: "locker-medicine", closed: "medical", open: "medicalopen", locked: "medical1", access: ["medical"]),
    (id: "locker-anesthetic", closed: "medical", open: "medicalopen", locked: "medical1", access: ["medical"], contents: [(id: "breath-mask"), (id: "breath-mask"), (id: "breath-mask"), (id: "breath-mask")]),
    (id: "locker-blood", closed: "medical", open: "medicalopen", locked: "medical1", access: ["medical"]),
    (id: "locker-genetics", closed: "securemed", open: "securemedopen", locked: "securemed1", access: ["medlab"], contents: [(id: "white-shoes"), (id: "radio"), (id: "latex-gloves")]),
    (id: "locker-meat", closed: "fridge", open: "fridgeopen"),
    (id: "locker-chemist", closed: "securechem", open: "secureresopen", locked: "securechem1", access: ["chemistry"], contents: [(id: "radio"), (id: "science-goggles"), (id: "brown-shoes")]),
    (id: "locker-animal", closed: "secure", open: "secureopen", locked: "secure1", access: ["medical"], contents: [(id: "radio"), (id: "radio"), (id: "radio"), (id: "radio"), (id: "radio")]),
    (id: "locker-roboticist", closed: "secureres", open: "secureresopen", locked: "secureres1", access: ["robotics"], contents: [(id: "black-shoes"), (id: "radio"), (id: "black-gloves")]),
    (id: "locker-botanist", closed: "hydrosecure", open: "hydrosecureopen", locked: "hydrosecure1", access: ["hydroponics"], contents: [(id: "black-shoes"), (id: "black-gloves"), (id: "radio")]),
    (id: "locker-cargo", closed: "securecargo", open: "securecargoopen", locked: "securecargo1", access: ["cargo"], contents: [(id: "black-shoes"), (id: "radio"), (id: "black-gloves"), (id: "helmet")]),
    (id: "locker-booze", closed: "cabinetdetective", open: "cabinetdetective_open", locked: "cabinetdetective_locked", access: ["bar"]),
    (id: "locker-warden", closed: "wardensecure", open: "wardensecureopen", locked: "wardensecure1", access: ["armory"], contents: [(id: "clipboard"), (id: "radio"), (id: "sunglasses"), (id: "stun-baton"), (id: "energy-gun"), (id: "flash"), (id: "jackboots"), (id: "helmet"), (id: "black-gloves")]),
    (id: "locker-rd", closed: "rdsecure", open: "rdsecureopen", locked: "rdsecure1", access: ["heads"], contents: [(id: "brown-shoes"), (id: "latex-gloves"), (id: "radio"), (id: "oxygen-tank"), (id: "gas-mask"), (id: "flash"), (id: "glasses")]),
    (id: "locker-quartermaster", closed: "secureqm", open: "secureqmopen", locked: "secureqm1", access: ["cargo"], contents: [(id: "brown-shoes"), (id: "radio"), (id: "black-gloves")]),
    (id: "locker-kitchen", closed: "secure", open: "secureopen", locked: "secure1", access: ["kitchen"]),
    (id: "locker-hos", closed: "hossecure", open: "hossecureopen", locked: "hossecure1", access: ["heads"], contents: [(id: "radio"), (id: "sunglasses")]),
    (id: "locker-hop", closed: "hopsecure", open: "hopsecureopen", locked: "hopsecure1", access: ["heads"], contents: [(id: "armor-vest"), (id: "helmet"), (id: "radio"), (id: "brown-shoes"), (id: "energy-gun"), (id: "flash"), (id: "sunglasses")]),
    (id: "locker-forensics", closed: "sec", open: "secopen", locked: "sec1", access: ["forensics_lockers"], contents: [(id: "radio"), (id: "brown-shoes")]),
    (id: "locker-detective", closed: "cabinetdetective", open: "cabinetdetective_open", locked: "cabinetdetective_locked", access: ["forensics_lockers"], contents: [(id: "black-gloves"), (id: "brown-shoes"), (id: "clipboard"), (id: "radio")]),
    (id: "locker-courtroom", closed: "secure", open: "secureopen", locked: "secure1", access: ["heads"], contents: [(id: "brown-shoes"), (id: "paper"), (id: "paper"), (id: "paper"), (id: "pen")]),
    (id: "locker-captain", closed: "capsecure", open: "capsecureopen", locked: "capsecure1", access: ["captain"], contents: [(id: "radio"), (id: "energy-gun")]),
    (id: "closet-legal", closed: "blue", open: "open", contents: [(id: "brown-shoes"), (id: "brown-shoes"), (id: "black-shoes"), (id: "lawyer-suit"), (id: "blue-suit"), (id: "purple-suit"), (id: "brown-shoes"), (id: "black-shoes")]),
    (id: "closet-bio-security", closed: "bio_security", open: "bio_securityopen", contents: [(id: "latex-gloves")]),
    (id: "closet-bio-janitor", closed: "bio_janitor", open: "bio_janitoropen", contents: [(id: "latex-gloves")]),
    (id: "closet-custodial", closed: "mixed", open: "open", contents: [(id: "black-shoes"), (id: "black-shoes"), (id: "flashlight"), (id: "flashlight"), (id: "caution"), (id: "caution"), (id: "caution"), (id: "caution"), (id: "caution"), (id: "caution"), (id: "black-gloves"), (id: "flashlight"), (id: "caution"), (id: "caution"), (id: "caution"), (id: "caution")]),
    (id: "closet-eod", closed: "bombsuit", open: "bombsuitopen", contents: [(id: "black-shoes")]),
    (id: "closet-eod-security", closed: "bombsuitsec", open: "bombsuitsecopen", contents: [(id: "jackboots")]),
    // Luna `closet/coffin`.
    (id: "closet-coffin", closed: "coffin", open: "coffin_open"),

    // Secure lockers (secure/personal.dm, secure/security.dm). Luna's personal locker also
    // opens for the first card swiped on it; ours only for its access (cards carry no names
    // yet). Its backpack and headset, the brig locker's orange jumpsuit and shoes, and the
    // security locker's gear have no prototypes yet.
    (id: "locker-personal", closed: "secure", open: "secureopen", locked: Some("secure1"),
        access: ["all_personal_lockers"]),
    (id: "locker-brig", closed: "secure", open: "secureopen", locked: Some("secure1"),
        access: ["security"]),
    (id: "locker-security", closed: "sec", open: "secopen", locked: Some("sec1"),
        access: ["security"]),

    // Secure lockers (secure/engineering.dm).
    (id: "locker-chief-engineer", closed: "securece", open: "secureceopen", locked: Some("securece1"),
        access: ["heads"], contents: [
        (id: "insulated-gloves"), (id: "toolbox-mechanical"), (id: "utility-belt"), (id: "multitool"),
    ]),
    (id: "locker-electrical", closed: "secureengelec", open: "toolclosetopen", locked: Some("secureengelec1"),
        access: ["engine_equip"], contents: [
        (id: "insulated-gloves"), (id: "insulated-gloves"),
        (id: "toolbox-electrical"), (id: "toolbox-electrical"), (id: "toolbox-electrical"),
        (id: "multitool"), (id: "multitool"), (id: "multitool"),
    ]),
    (id: "locker-welding", closed: "secureengweld", open: "toolclosetopen", locked: Some("secureengweld1"),
        access: ["engine_equip"]),
    (id: "locker-engineer", closed: "secureeng", open: "secureengopen", locked: Some("secureeng1"),
        access: ["engine_equip"], contents: [
        (id: "utility-belt"), (id: "toolbox-mechanical"), (id: "insulated-gloves"),
    ]),

    // Crates (crates.dm).
    (id: "crate", crate: true, closed: "crate", open: "crateopen"),
    // Luna: three gas masks, and an oxygen or air tank and two air tanks.
    (id: "crate-internals", crate: true, closed: "o2crate", open: "o2crateopen", contents: [
        (id: "oxygen-tank", chance: 50.0),
    ]),
    // Luna `internalsoxy`, only put out by a derelict round: three gas masks and three oxygen tanks.
    (id: "crate-internals-oxy", crate: true, closed: "o2crate", open: "o2crateopen", contents: [
        (id: "gas-mask"), (id: "oxygen-tank"), (id: "gas-mask"), (id: "oxygen-tank"), (id: "gas-mask"), (id: "oxygen-tank"),
    ]),
    (id: "crate-engineering", crate: true, closed: "engi_crate", open: "engi_crate_open"),
    (id: "crate-medical", crate: true, closed: "medicalcrate", open: "medicalcrateopen"),
    (id: "crate-electrical", crate: true, closed: "engi_e_crate", open: "engi_e_crate_open"),
    // Secure crates (Luna `crate/secure`): a card lock, its light red while locked and green
    // while not. Cargo sets the access its pack asks for (`cargo.md`).
    (id: "crate-secure", crate: true, closed: "securecrate+securecrateg", open: "securecrateopen",
        locked: "securecrate+securecrater"),
    (id: "crate-secure-weapon", crate: true, closed: "weaponcrate+securecrateg", open: "weaponcrateopen",
        locked: "weaponcrate+securecrater"),
    (id: "crate-secure-plasma", crate: true, closed: "plasmacrate+securecrateg", open: "plasmacrateopen",
        locked: "plasmacrate+securecrater"),
    (id: "crate-secure-gear", crate: true, closed: "secgearcrate+securecrateg", open: "secgearcrateopen",
        locked: "secgearcrate+securecrater"),
    (id: "crate-radiation", crate: true, closed: "radiation", open: "radiationopen"),
    (id: "crate-rcd", crate: true, closed: "crate", open: "crateopen"),
    // Luna `crate/badmin/wizard`, an admin's. Its blue jumpsuit isn't built yet.
    (id: "crate-wizard", crate: true, closed: "crate", open: "crateopen", contents: [
        (id: "teleportation-scroll"), (id: "spellbook"), (id: "magic-staff"),
        (id: "sandals"), (id: "wizard-robe"), (id: "wizard-hat"),
    ]),
]
