            "temp-2": (dmi: "icons/mob/screen1.dmi", state: "temp-2"),
            "temp-1": (dmi: "icons/mob/screen1.dmi", state: "temp-1"),
            "temp0": (dmi: "icons/mob/screen1.dmi", state: "temp0"),
            "temp1": (dmi: "icons/mob/screen1.dmi", state: "temp1"),
            "temp2": (dmi: "icons/mob/screen1.dmi", state: "temp2"),
            "temp3": (dmi: "icons/mob/screen1.dmi", state: "temp3"),
            "temp4": (dmi: "icons/mob/screen1.dmi", state: "temp4"),
            "health0": (dmi: "icons/mob/screen1.dmi", state: "health0"),
            "health1": (dmi: "icons/mob/screen1.dmi", state: "health1"),
            "health2": (dmi: "icons/mob/screen1.dmi", state: "health2"),
            "health3": (dmi: "icons/mob/screen1.dmi", state: "health3"),
