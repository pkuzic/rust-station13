        // Atmospherics. Pipes: state = the two directions joined, as for cables.
        "pipe": {
            "1-2": (dmi: "icons/obj/pipes.dmi", state: "intact", dir: 1),
            "4-8": (dmi: "icons/obj/pipes.dmi", state: "intact", dir: 2),
