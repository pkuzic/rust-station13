            "center": (dmi: "icons/mob/screen1.dmi", state: "center"),
            "hair": (dmi: "icons/mob/screen1.dmi", state: "hair"),
            "belt": (dmi: "icons/mob/screen1.dmi", state: "belt"),
            // An open container: a cell behind each item, and the close button.
            "block": (dmi: "icons/mob/screen1.dmi", state: "block"),
            "close": (dmi: "icons/mob/screen1.dmi", state: "x"),
            "shoes": (dmi: "icons/mob/screen1.dmi", state: "shoes"),
            "gloves": (dmi: "icons/mob/screen1.dmi", state: "gloves"),
