        "cable-coil": {
            "": (dmi: "icons/obj/Coils.dmi", state: "redcoil3"),
            "2": (dmi: "icons/obj/Coils.dmi", state: "redcoil2"),
            "1": (dmi: "icons/obj/Coils.dmi", state: "redcoil1"),
