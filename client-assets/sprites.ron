        "toolbox-mechanical": { "": (dmi: "icons/obj/storage.dmi", state: "blue") },
        "toolbox-electrical": { "": (dmi: "icons/obj/storage.dmi", state: "yellow") },
        "utility-belt": { "": (dmi: "icons/obj/clothing/belts.dmi", state: "utilitybelt") },
        "metal-sheet": { "": (dmi: "icons/obj/items.dmi", state: "sheet-metal") },
        "floor-tile": { "": (dmi: "icons/obj/items.dmi", state: "tile") },
        "id-card": { "": (dmi: "icons/obj/card.dmi", state: "id") },
        "oxygen-tank": { "": (dmi: "icons/obj/tank.dmi", state: "oxygen") },
        "emergency-oxygen": { "": (dmi: "icons/obj/tank.dmi", state: "emergency") },
        "grey-jumpsuit": { "": (dmi: "icons/obj/clothing/uniforms.dmi", state: "grey") },
        "black-shoes": { "": (dmi: "icons/obj/clothing/shoes.dmi", state: "black") },
        "insulated-gloves": { "": (dmi: "icons/obj/clothing/gloves.dmi", state: "yellow") },
        "breath-mask": { "": (dmi: "icons/obj/clothing/masks.dmi", state: "breath") },
        "space-suit": { "": (dmi: "icons/obj/clothing/suits.dmi", state: "space") },
        "space-helmet": { "": (dmi: "icons/obj/clothing/hats.dmi", state: "space") },

        // The classic HUD (Luna `human_hud`): bar backgrounds, slot frames, buttons and
        // indicators. `dir` picks the frame variant Luna sets with `dir =`.
        "hud": {
            "bar-e": (dmi: "icons/mob/screen1.dmi", state: "", dir: Some(2)),
            "bar-s": (dmi: "icons/mob/screen1.dmi", state: "", dir: Some(0)),
            "bar-nw": (dmi: "icons/mob/screen1.dmi", state: "", dir: Some(7)),
            "equip-s": (dmi: "icons/mob/screen1.dmi", state: "equip", dir: Some(0)),
            "equip-n": (dmi: "icons/mob/screen1.dmi", state: "equip", dir: Some(1)),
